# =========================================================================
# CONFIGURACIÓN DE ENTORNO LOCAL (.env.example)
# =========================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env'.
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. NUNCA subas el archivo '.env' al control de versiones (Git).
# =========================================================================

# --- Aplicación (Spring Boot) ---
# Puerto donde correrá el backend (Opcional, útil si choca con otros servicios)
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev

# --- Base de Datos (PostgreSQL Docker) ---
DB_USERNAME=admin
# Usa una contraseña sencilla solo para local (ej. root, postgres, o tu clave local)
DB_PASSWORD=escribe_tu_password_local_aqui
DB_NAME=entrenaback
# Mapeado al 5433 en el host para evitar conflictos con instancias locales de Postgres en el 5432
POSTGRES_PORT=5433

# --- Seguridad e Identidad (JWT) ---
# Genera un string largo y aleatorio. Para HS256 se recomiendan al menos 256 bits (32 caracteres).
JWT_SECRET=reemplaza_por_una_cadena_muy_larga_y_segura_para_firmar_tokens
# Tiempo de expiración del token en milisegundos (Ejemplo: 86400000 = 1 día)
JWT_EXPIRATION=86400000

# --- Inteligencia Artificial (Gemini API) ---
# Genera o recupera tu API key desde: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_reemplaza_esto_con_tu_api_key_real